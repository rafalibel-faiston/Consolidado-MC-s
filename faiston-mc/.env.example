# Postgres do Railway preenche isso sozinho quando você linka o plugin
# ao serviço (referência ${{Postgres.DATABASE_URL}}). Só precisa preencher
# na mão pra rodar local.
DATABASE_URL=postgresql://user:password@localhost:5432/faiston_mc

# Senha única compartilhada pela equipe pra entrar no painel.
APP_PASSWORD=troque-isto

# Chave usada pra assinar o cookie de sessão — gere algo aleatório e comprido.
# Exemplo: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-isto-tambem

# Opcional — dias que a sessão de login fica válida. Padrão 30.
SESSION_MAX_AGE_DAYS=30

# Opcional — só desliga se estiver testando local em http puro (não https).
COOKIE_SECURE=true
